            "nota_foto": "Poêle antiadhésive dont le revêtement s'écaille"
          }
        },
        "c2": {
          "type": "carta",
          "settings": {
            "titolo": "Acciaio inox",
            "testo": "Richiede molto olio e reagisce con gli alimenti acidi — altera il sapore e cede metalli. Difficile da pulire.",
            "nota_foto": "Poêle en acier avec aliments collés"
          }
        },
        "c3": {
          "type": "carta",
          "settings": {
            "titolo": "Ghisa",
            "testo": "Pesante, lenta a scaldarsi, va ricondizionata. Un errore di lavaggio e arrugginisce.",
            "nota_foto": "Poêle en fonte rouillée"
          }
        },
        "c4": {
          "type": "carta",
          "settings": {
            "titolo": "Ceramica",
            "testo": "Antiaderente all'inizio, poi non più. Perde efficacia in pochi mesi.",
            "nota_foto": "Poêle céramique ternie"
          }
        }
      },
