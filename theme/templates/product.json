            "titolo": "Verificata, non solo dichiarata.",
            "contenuto": "<p>Da completare con il tuo rapporto di laboratorio: nome del laboratorio, data e sostanze ricercate.</p>"
          }
        },
        "s3": {
          "type": "scheda",
          "settings": {
            "etichetta": "Titanio<br>e gli altri",
            "titolo": "Il titanio e tutti gli altri.",
            "tabella": "<table class=\"confronto\"><thead><tr><th></th><th>Antiaderente</th><th>Acciaio inox</th><th class=\"noi\">Titanio Vero</th></tr></thead><tbody>\n<tr><th>Superficie non tossica</th><td>✕</td><td>✓</td><td class=\"noi\">✓</td></tr>\n<tr><th>Resiste alle alte temperature</th><td>✕</td><td>✓</td><td class=\"noi\">✓</td></tr>\n<tr><th>Facile da pulire</th><td>✓</td><td>✕</td><td class=\"noi\">✓</td></tr>\n<tr><th>Non si deforma</th><td>✕</td><td>✓</td><td class=\"noi\">✓</td></tr>\n<tr><th>Lavabile in lavastoviglie</th><td>✕</td><td>✓</td><td class=\"noi\">✓</td></tr>\n<tr><th>Utensili in metallo</th><td>✕</td><td>✓</td><td class=\"noi\">✓</td></tr>\n<tr><th>Quanto dura</th><td><span class=\"durata\">1 anno</span></td><td><span class=\"durata\">5–7 anni</span></td><td class=\"noi\"><span class=\"durata forte\">Per sempre</span></td></tr>\n</tbody></table>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ]
    },
