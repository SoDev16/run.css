    "faq": {
      "type": "tv-faq",
      "settings": {
        "titolo": "Domande frequenti"
      },
      "blocks": {
        "d1": {
          "type": "domanda",
          "settings": {
            "domanda": "Come può essere antiaderente senza rivestimento?",
            "risposta": "<p>La superficie è microincisa, non ricoperta. I micro-rilievi riducono i punti di contatto: il cibo scivola invece di aderire.</p>"
          }
        },
        "d2": {
          "type": "domanda",
          "settings": {
            "domanda": "Il titanio è sicuro a contatto con gli alimenti?",
            "risposta": "<p>Il titanio è usato da decenni negli impianti medici per la sua stabilità: non reagisce e non rilascia particelle.</p>"
          }
        },
        "d3": {
          "type": "domanda",
          "settings": {
            "domanda": "Funziona su induzione, gas e vetroceramica?",
            "risposta": "<p>Sì, su tutti i piani cottura. Il fondo in acciaio inox garantisce la conduttività magnetica.</p>"
          }
        },
        "d4": {
          "type": "domanda",
          "settings": {
            "domanda": "Posso metterla in forno?",
            "risposta": "<p>Sì. Nessun rivestimento significa nessuna temperatura limite legata a una pellicola.</p>"
          }
        },
        "d5": {
          "type": "domanda",
          "settings": {
            "domanda": "Posso lavarla in lavastoviglie?",
            "risposta": "<p>Sì. Non c'è rivestimento da preservare.</p>"
          }
        },
        "d6": {
          "type": "domanda",
          "settings": {
            "domanda": "Posso usare utensili in metallo?",
            "risposta": "<p>Sì. Niente da graffiare.</p>"
          }
        },
        "d7": {
          "type": "domanda",
          "settings": {
            "domanda": "Serve olio o burro?",
            "risposta": "<p>Molto poco, e spesso niente.</p>"
          }
        },
        "d8": {
          "type": "domanda",
          "settings": {
            "domanda": "Che cos'è la costruzione a 5 strati?",
