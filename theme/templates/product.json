      "blocks": {
        "s1": {
          "type": "scheda",
          "settings": {
            "etichetta": "Benefici<br>per la salute",
            "titolo": "Un nuovo standard di sicurezza, prestazioni e durata.",
            "contenuto": "<p><strong>Titanio puro — il metallo più sicuro a contatto con il corpo.</strong> Usato da decenni negli impianti medici per la sua biocompatibilità.</p><p><strong>Antiaderente senza sostanze chimiche.</strong> La superficie è microincisa, non rivestita.</p>"
