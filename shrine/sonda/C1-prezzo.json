dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":36,"padding_bottom":36,"custom_colors_background":"#121212","custom_gradient_background":"","custom_colors_text":"#FFFFFF","custom_cards_colors_background":"#1C1C1C","custom_cards_gradient_background":"","custom_cards_colors_text":"#FFFFFF"}},"lettera":{"type":"custom-columns","blocks":{"let_h":{"type":"heading","settings":{"column":"col_1","visibility":"always-display","heading":"La salute è ciò che abbiamo di più prezioso.","title_highlight_color":"#BCA588","heading_size":"h1","alignment":"center","mobile_alignment":"mobile-center","margin_top":20,"margin_bottom":20}},"let_p":{"type":"richtext","settings":{"column":"col_1","visibility":"always-display","text":"<p>È il motivo per cui esiste Titanio Vero.</p>","text_style":"body","alignment":"center","mobile_alignment":"mobile-center","margin_top":20,"margin_bottom":20}}},"block_order":["let_h","let_p"],"settings":{"display_id":false,"visibility":"always-display","color_scheme":"custom","columns_count":2,"column_gap_desktop":40,"row_gap_desktop":40,"desktop_vertical_alignment":"center","column_gap_mobile":20,"row_gap_mobile":30,"mobile_vertical_alignment":"flex-start","col_1_desktop_width":12,"col_1_mobile_width":4,"col_1_visibility":"always-display","col_2_desktop_width":4,"col_2_mobile_width":4,"col_2_visibility":"always-display","col_3_desktop_width":4,"col_3_mobile_width":4,"col_3_visibility":"always-display","col_4_desktop_width":4,"col_4_mobile_width":4,"col_4_visibility":"always-display","col_5_desktop_width":3,"col_5_mobile_width":4,"col_5_visibility":"always-display","col_6_desktop_width":3,"col_6_mobile_width":4,"col_6_visibility":"always-display","padding_top":36,"padding_bottom":36,"custom_colors_background":"#1C1C1C","custom_gradient_background":"","custom_colors_text":"#D4C7B4","custom_colors_solid_button_background":"#BF092F","custom_colors_solid_button_text":"#FFFFFF","custom_colors_outline_button":"#BCA588"}},"faq":{"type":"collapsible-content","blocks":{"f_q1":{"type":"collapsible_row","settings":{"heading":"Come funziona una superficie antiaderente senza rivestimento?","icon":"check_box","filled_icon":false,"row_content":"<p>La superficie del titanio è microincisa. Le microcreste riducono i punti di contatto e distribuiscono l'olio, così il cibo scivola invece di attaccarsi. Non c'è pellicola, quindi non c'è nulla che possa staccarsi.</p>","page":""}},"f_q2":{"type":"collapsible_row","settings":{"heading":"È adatta all'induzione?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì. Funziona su induzione, gas, piastra elettrica e vetroceramica.</p>","page":""}},"f_q3":{"type":"collapsible_row","settings":{"heading":"Il titanio è sicuro a contatto con il cibo?","icon":"check_box","filled_icon":false,"row_content":"<p>Il titanio puro è usato da decenni negli impianti medici per la sua biocompatibilità. Non è tossico e non reagisce con gli alimenti.</p>","page":""}},"f_q4":{"type":"collapsible_row","settings":{"heading":"Posso usare utensili di metallo?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì. Non c'è rivestimento da graffiare.</p>","page":""}},"f_q5":{"type":"collapsible_row","settings":{"heading":"Si può lavare in lavastoviglie?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì, senza alcuna precauzione particolare.</p>","page":""}},"f_q6":{"type":"collapsible_row","settings":{"heading":"A che temperatura si cucina?","icon":"check_box","filled_icon":false,"row_content":"<p>Il titanio dà il meglio a fuoco medio. Non serve la fiamma altissima, e il calore si distribuisce fino ai bordi.</p>","page":""}},"f_q7":{"type":"collapsible_row","settings":{"heading":"Quale misura scelgo?","icon":"check_box","filled_icon":false,"row_content":"<p>La 26 cm è la più versatile per due persone. La 28 cm serve quando cucini spesso per tre o quattro.</p>","page":""}},"f_q8":{"type":"collapsible_row","settings":{"heading":"E se non mi convince?","icon":"check_box","filled_icon":false,"row_content":"<p>Hai 120 giorni per provarla. La rendi e ti rimborsiamo per intero.</p>","page":""}}},"block_order":["f_q1","f_q2","f_q3","f_q4","f_q5","f_q6","f_q7","f_q8"],"settings":{"caption":"Le domande che ci fate più spesso","heading_size":"h0","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"benefici_argomenti":{"type":"collapsible-content","blocks":{"benefici_argomenti_b1":{"type":"collapsible_row","settings":{"heading":"Titanio puro, il metallo più sicuro a contatto con il corpo","icon":"check_circle","filled_icon":false,"row_content":"<p>Il titanio è lo stesso metallo usato da decenni negli impianti medici, proprio per la sua biocompatibilità. Non rilascia nulla nel cibo e non reagisce con gli alimenti.</p>","page":""}},"benefici_argomenti_b2":{"type":"collapsible_row","settings":{"heading":"Antiaderente senza alcun rivestimento","icon":"check_circle","filled_icon":false,"row_content":"<p>La superficie non è ricoperta: è microincisa. Le micro-creste riducono i punti di contatto e distribuiscono l'olio, così il cibo si stacca da solo. Non c'è pellicola, quindi non c'è nulla che possa scrostarsi nel tempo.</p>","page":""}},"benefici_argomenti_b3":{"type":"collapsible_row","settings":{"heading":"Cuoci a fuoco medio, non altissimo","icon":"check_circle","filled_icon":false,"row_content":"<p>Il titanio conduce il calore in modo uniforme fino ai bordi. Non serve la fiamma alta: una cottura più dolce rispetta la consistenza e il sapore degli ingredienti.</p>","page":""}},"benefici_argomenti_b4":{"type":"collapsible_row","settings":{"heading":"Resiste agli alimenti acidi","icon":"check_circle","filled_icon":false,"row_content":"<p>Pomodoro, limone, aceto, peperoni: puoi cucinarli senza intaccare la superficie e senza trasferimento di metalli nel cibo. È la differenza più evidente rispetto all'acciaio e all'alluminio.</p>","page":""}},"benefici_argomenti_b5":{"type":"collapsible_row","settings":{"heading":"Fatta per durare","icon":"check_circle","filled_icon":false,"row_content":"<p>Il titanio è scelto in aeronautica e in medicina perché regge calore e sollecitazioni senza deformarsi. Resiste agli utensili di metallo e al forno. Anni dopo, la padella è ancora quella del primo giorno.</p>","page":""}},"benefici_argomenti_b6":{"type":"collapsible_row","settings":{"heading":"Facile da tenere pulita","icon":"check_circle","filled_icon":false,"row_content":"<p>La superficie liscia e non porosa non trattiene i residui. Acqua calda e sapone bastano, e va in lavastoviglie senza precauzioni particolari.</p>","page":""}},"benefici_argomenti_b7":{"type":"collapsible_row","settings":{"heading":"Meno olio, stesso risultato","icon":"check_circle","filled_icon":false,"row_content":"<p>Basta un filo d'olio perché il cibo scivoli. Non serve ricoprire il fondo come con una padella tradizionale.</p>","page":""}},"benefici_argomenti_b8":{"type":"collapsible_row","settings":{"heading":"Cucini senza pensieri","icon":"check_circle","filled_icon":false,"row_content":"<p>Senza PFAS, PTFE e PFOA. Nessun interferente ormonale, nessun rivestimento che invecchia e finisce nel piatto.</p>","page":""}}},"block_order":["benefici_argomenti_b1","benefici_argomenti_b2","benefici_argomenti_b3","benefici_argomenti_b4","benefici_argomenti_b5","benefici_argomenti_b6","benefici_argomenti_b7","benefici_argomenti_b8"],"settings":{"caption":"Un nuovo standard di sicurezza, prestazioni e durata.","heading_size":"h0","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":true,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}}},"order":["main","striscia","garanzie","benefici_argomenti","ripensare","confronto","strati","mosaico","merita","amazon","testimonianze","faq","lettera"]}