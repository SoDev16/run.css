colors_text":"#D4C7B4","custom_colors_solid_button_background":"#BF092F","custom_colors_solid_button_text":"#FFFFFF","custom_colors_outline_button":"#BCA588"}},"h_faq":{"type":"collapsible-content","blocks":{"h_f_q1":{"type":"collapsible_row","settings":{"heading":"Come funziona una superficie antiaderente senza rivestimento?","icon":"check_box","filled_icon":false,"row_content":"<p>La superficie del titanio è microincisa. Le microcreste riducono i punti di contatto e distribuiscono l'olio, così il cibo scivola invece di attaccarsi. Non c'è pellicola, quindi non c'è nulla che possa staccarsi.</p>","page":""}},"h_f_q2":{"type":"collapsible_row","settings":{"heading":"È adatta all'induzione?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì. Funziona su induzione, gas, piastra elettrica e vetroceramica.</p>","page":""}},"h_f_q3":{"type":"collapsible_row","settings":{"heading":"Il titanio è sicuro a contatto con il cibo?","icon":"check_box","filled_icon":false,"row_content":"<p>Il titanio puro è usato da decenni negli impianti medici per la sua biocompatibilità. Non è tossico e non reagisce con gli alimenti.</p>","page":""}},"h_f_q4":{"type":"collapsible_row","settings":{"heading":"Posso usare utensili di metallo?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì. Non c'è rivestimento da graffiare.</p>","page":""}},"h_f_q5":{"type":"collapsible_row","settings":{"heading":"Si può lavare in lavastoviglie?","icon":"check_box","filled_icon":false,"row_content":"<p>Sì, senza alcuna precauzione particolare.</p>","page":""}},"h_f_q6":{"type":"collapsible_row","settings":{"heading":"A che temperatura si cucina?","icon":"check_box","filled_icon":false,"row_content":"<p>Il titanio dà il meglio a fuoco medio. Non serve la fiamma altissima, e il calore si distribuisce fino ai bordi.</p>","page":""}},"h_f_q7":{"type":"collapsible_row","settings":{"heading":"Quale misura scelgo?","icon":"check_box","filled_icon":false,"row_content":"<p>La 26 cm è la più versatile per due persone. La 28 cm serve quando cucini spesso per tre o quattro.</p>","page":""}},"h_f_q8":{"type":"collapsible_row","settings":{"heading":"E se non mi convince?","icon":"check_box","filled_icon":false,"row_content":"<p>Hai 120 giorni per provarla. La rendi e ti rimborsiamo per intero.</p>","page":""}}},"block_order":["h_f_q1","h_f_q2","h_f_q3","h_f_q4","h_f_q5","h_f_q6","h_f_q7","h_f_q8"],"settings":{"caption":"Le domande che ci fate più spesso","heading_size":"h0","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}}},"order":["eroe","h_striscia","garanzie","argomenti","h_ripensare","confronto","h_strati","h_mosaico","merita","h_amazon","h_testimonianze","h_faq","h_lettera"]}